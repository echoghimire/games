{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "arena-game",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "arena.ktmtronix.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    // Every request goes through the Worker first so only paying players get
    // the game page, engine and WADs.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ktm-arena",
      // Same database as the landing Worker.
      "database_id": "4d9760b1-221d-496f-bdfb-879150db80a0",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "WADS", "bucket_name": "ktm-arena-wads" }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "FIGHTS", "class_name": "FightRoom" },
      { "name": "PARTIES", "class_name": "PartyRoom" },
      { "name": "WPILOT", "class_name": "WPilotRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["FightRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["PartyRoom"] },
    { "tag": "v4", "new_sqlite_classes": ["WPilotRoom"] }
  ],
  "vars": {
    "LANDING_URL": "https://game.ktmtronix.com",
    "ARENA_URL": "https://arena.ktmtronix.com",
    "COOKIE_DOMAIN": "ktmtronix.com"
  }
  // Secrets: SESSION_SECRET (must match the landing Worker's).
}
